# Local development only; these credentials are not production secrets.
APP_ENV=local
HTTP_ADDR=:8080
DATABASE_URL=postgres://max_together:local-dev-only@localhost:5432/max_together?sslmode=disable
LOG_LEVEL=info
POSTGRES_DB=max_together
POSTGRES_USER=max_together
POSTGRES_PASSWORD=local-dev-only
POSTGRES_PORT=5432
BACKEND_PORT=8080

# Server authentication and invitation configuration.
MAX_BOT_TOKEN=
MAX_INIT_DATA_MAX_AGE=1h
# Generate once: openssl rand -base64 32. Keep stable across restarts.
INVITE_ENCRYPTION_KEY=
INVITE_ENCRYPTION_KEY_VERSION=1
# Deployment-specific HTTPS URLs, each containing exactly one {token}.
INVITE_URL_TEMPLATE=
MAX_DEEP_LINK_TEMPLATE=

# Reserved for later features; the application does not consume these yet.
DATA_RESIDENCY=RU
MAX_BOT_NAME=
SESSION_TTL=24h
SESSION_TOKEN_PEPPER=
INVITE_TTL=48h
ROOM_TTL=48h
MAX_ROOM_ROUNDS=3
ROOM_POOL_TARGET=20
ROOM_POOL_MAX=24
RANKER_VERSION=rules-v1
RANKER_TIEBREAK_SECRET=
CURSOR_SIGNING_KEY=
TICKET_PROVIDER_ALLOWLIST=
PRIVACY_POLICY_VERSION=2026-09-16
TERMS_VERSION=2026-09-16
SUPPORT_CONTACT=
DEMO_MODE=true
DEMO_BASE_DATE=
