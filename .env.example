# Безопасные значения только для изолированного локального стека сдачи. Не используйте в production.
COMPOSE_PROJECT_NAME=max-together-submission
APP_ENV=local
HTTP_ADDR=:8080
LOG_LEVEL=info

POSTGRES_DB=max_together_submission
POSTGRES_USER=max_together_submission
POSTGRES_PASSWORD=submission-only-password
POSTGRES_PORT=5432
BACKEND_PORT=8080
FRONTEND_PORT=8081
BACKEND_IMAGE=max-together-backend:local
FRONTEND_IMAGE=max-together-frontend:local
DATABASE_URL=postgres://max_together_submission:submission-only-password@postgres:5432/max_together_submission?sslmode=disable

# Фиктивное значение для локального окружения. Настоящие MAX init data с этим токеном не пройдут проверку.
MAX_BOT_TOKEN=submission-only-bot-token
MAX_INIT_DATA_MAX_AGE=1h
INVITE_ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
INVITE_ENCRYPTION_KEY_VERSION=1
INVITE_URL_TEMPLATE=https://example.invalid/join/{token}
MAX_DEEP_LINK_TEMPLATE=https://max.example.invalid/bot?startapp={token}

# Локальный бэкенд разрешает тестовые ссылки; фронтенд также принимает ссылки реальных провайдеров.
TICKET_PROVIDER_ALLOWLIST=tickets.example.invalid
VITE_TICKET_PROVIDER_ALLOWLIST=kudago.com,*.kudago.com,timepad.ru,*.timepad.ru,tickets.example.invalid
VITE_API_BASE_URL=/api/v1
VITE_MAX_APP_URL=https://max.ru/t255_hakaton_max_bot
VITE_YANDEX_MAPS_API_KEY=

# Встроенные API выключены. Включать только после согласованной проверки доступа.
EVENT_SYNC_KUDAGO_ENABLED=false
EVENT_SYNC_TIMEPAD_ENABLED=false
TIMEPAD_TOKEN=
TIMEPAD_MAX_REQUESTS_PER_MINUTE=6
KUDAGO_MAX_REQUESTS_PER_MINUTE=6
KUDAGO_MAX_PAGES_PER_RUN=20
TIMEPAD_MAX_PAGES_PER_RUN=20
EVENT_SYNC_MAX_RUN_DURATION=45m
EVENT_SYNC_UPSERT_ONLY=true
EVENT_SYNC_INTERVAL=24h
EVENT_SYNC_RUN_ON_START=false
# Петербург: opt-in compose profile spb; оба флага по умолчанию OFF.
SPB_EVENT_SYNC_KUDAGO_ENABLED=false
SPB_EVENT_SYNC_TIMEPAD_ENABLED=false
SPB_EVENT_SYNC_UPSERT_ONLY=true
DEMO_BASE_DATE=
